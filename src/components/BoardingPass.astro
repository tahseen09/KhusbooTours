---
import type { CollectionEntry } from 'astro:content';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { formatPrice, whatsappLink } from '../lib/site';

interface Props { trip: CollectionEntry<'trips'>['data']; }
const { trip } = Astro.props;
const message = `Hi Khusboo Tours, I want to book the ${trip.name} tour (${trip.nights}).`;
---
<div class="pass">
  <div class="pass-top"><span class="label">Boarding pass</span><span class="label">Khusboo Tours</span></div>
  <div class="pass-route">
    <div><span class="pass-code">ROU</span><span class="pass-city">Rourkela</span></div>
    <svg viewBox="0 0 120 14" fill="none" stroke="currentColor" stroke-width="1.5" preserveAspectRatio="none" aria-hidden="true"><path d="M2 7h112" stroke-dasharray="2 5"/><path d="M110 2l6 5-6 5"/></svg>
    <div><span class="pass-code">{trip.iata}</span><span class="pass-city">{trip.city}</span></div>
  </div>
  <dl class="facts">
    <div><dt>Duration</dt><dd>{trip.nights.replace('/', ' / ')}</dd></div>
    <div><dt>Best time</dt><dd>{trip.best}</dd></div>
  </dl>
  <div class="pass-foot">
    <div class="pass-price"><span class="label">From, per person</span><b>{formatPrice(trip.price)}</b></div>
    <a class="btn" href={whatsappLink(message)} target="_blank" rel="noopener"><WhatsAppIcon /> Book on WhatsApp</a>
  </div>
</div>
