---
import Base from '../layouts/Base.astro';
import { withBase } from '../lib/site';
---
<Base title="Page not found · Khusboo Tours" description="This page does not exist." onPaper>
  <section class="page">
    <div class="wrap">
      <span class="label">Error 404</span>
      <h1>This page has moved on.</h1>
      <p>The tour you are looking for is not here. Every tour starts from the home page.</p>
      <a class="btn" href={withBase('')}>See all tours</a>
    </div>
  </section>
</Base>
