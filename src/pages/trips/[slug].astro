---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import { getImage } from 'astro:assets';
import Photo from '../../components/Photo.astro';
import Base from '../../layouts/Base.astro';
import BoardingPass from '../../components/BoardingPass.astro';
import WhatsAppIcon from '../../components/WhatsAppIcon.astro';
import { tourMessage, whatsappLink, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const trips = (await getCollection('trips')).sort((a, b) => a.data.order - b.data.order);
  return trips.map((trip) => ({ params: { slug: trip.id }, props: { trip, others: trips.filter((t) => t.id !== trip.id) } }));
}

interface Props { trip: CollectionEntry<'trips'>; others: CollectionEntry<'trips'>[]; }
const { trip, others } = Astro.props;
const t = trip.data;
const og = await getImage({ src: t.hero, width: 1200, format: 'jpg', quality: 70 });
const { Content } = await render(trip);
const bookMessage = tourMessage(t.name);
---
<Base
  title={`${t.name} tour from Rourkela · Khusboo Tours`}
  description={`${t.name} tour package from Rourkela. ${t.dek}`}
  ogImage={og.src}
  backLink
  whatsappMessage={bookMessage}
>
  <div style={`--c:${t.color};--on:${t.onColor}`}>
    <section class="trip-hero">
      <div class="hero-img"><Photo src={t.hero} alt={t.heroAlt} sizes="100vw" priority /></div>
      <div class="wrap">
        <span class="code">LINE {t.code} · {t.name.toUpperCase()}</span>
        <h1>{t.title}</h1>
        <p>{t.dek}</p>
        <a class="btn-wa" href={whatsappLink(bookMessage)} target="_blank" rel="noopener"><WhatsAppIcon /> Ask for dates on WhatsApp</a>
      </div>
    </section>

    <section class="trip-body">
      <div class="wrap trip-cols">
        <div class="itinerary">
          <div class="story"><Content /></div>
          <span class="eyebrow" style="display:block;margin-top:40px">The route · {t.days.length} stops</span>
          <h2>The plan</h2>
          <ol class="days">
            {t.days.map((d, i) => (
              <li class="day">
                <span class="day-line" aria-hidden="true"></span>
                <div class="day-body">
                  <span class="mono">STOP {i + 1} · {d.place.toUpperCase()}</span>
                  <h3>{d.title}</h3>
                  <p>{d.text}</p>
                </div>
              </li>
            ))}
          </ol>
          <p class="note">Day plans can change with weather, roads and permits. We confirm the final plan on WhatsApp before you pay.</p>
        </div>
        <aside class="trip-incl">
          <div class="trip-pass"><BoardingPass trip={t} /></div>
          <span class="eyebrow">In your ticket</span>
          <h2>Included</h2>
          <ul>
            {t.includes.map((item) => (
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>{item}</li>
            ))}
          </ul>
        </aside>
      </div>
    </section>

    {t.gallery.length > 0 && (
      <section class="gallery" aria-label={`${t.name} photos`}>
        {t.gallery.map((g) => (
          <figure>
            <Photo src={g.src} alt={g.alt} sizes="(min-width: 900px) 33vw, 100vw" />
            <figcaption>{g.caption}</figcaption>
          </figure>
        ))}
      </section>
    )}

    <section class="more-trips">
      <div class="wrap">
        <h2>Other lines from Rourkela</h2>
        <div class="more-list">
          {others.map(({ id, data: o }) => (
            <a href={withBase(`trips/${id}/`)} style={`--c:${o.color};--on:${o.onColor}`}>
              <Photo src={o.hero} alt="" sizes="(min-width: 900px) 300px, 100vw" />
              <span class="code">{o.code}</span>
              <b>{o.name}</b>
              <span class="more-title">{o.title}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

  </div>
</Base>
