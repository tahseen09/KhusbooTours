---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import BookingEngine from '../components/BookingEngine.astro';
import TourSearch from '../components/TourSearch.astro';
import ReserveBus from '../components/ReserveBus.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { EXTRA_DESTINATIONS as extras, tourMessage, whatsappLink, withBase } from '../lib/site';
import { photo } from '../lib/photos';
import coverPhoto from '../assets/photos/cover-dal-lake-houseboats.jpg';

const trips = (await getCollection('trips')).sort((a, b) => a.data.order - b.data.order);
const sizes = '(min-width: 1100px) 400px, (min-width: 700px) 50vw, 100vw';
const og = await getImage({ src: coverPhoto, width: 1200, format: 'jpg', quality: 70 });
---
<Base
  title="Khusboo Tours · Trips from Rourkela to Kashmir, Gangtok, Manali and Goa"
  description={`Tour packages from Rourkela, Odisha. Kashmir, Gangtok, Manali, Goa, Netarhat and Nepal with travel, hotels and sightseeing included. AC, Non-AC and Sleeper buses to reserve.`}
  ogImage={og.src}
>
  <section class="cover" aria-label="Cover">
    <div class="cover-img">
      <Photo src={coverPhoto} alt="Houseboats moored below snow-capped mountains" sizes="100vw" priority />
    </div>
    <h1 aria-label="Escape">
      <span class="row" aria-hidden="true">{[...'ESCAPE'].map((ch, i) => <span class="ch" style={`--i:${i}`}>{ch}</span>)}</span>
    </h1>
    <p class="dek">The issue for people who need a weekend that lasts a week.</p>
    <div class="cover-foot">
      <TourSearch />
      <div class="cover-lines">
        <a href={withBase('trips/kashmir/')} style="--i:0">Snow before breakfast <span>— Gulmarg</span></a>
        <a href={withBase('trips/goa/')} style="--i:1">Goa at golden hour <span>— Mandrem</span></a>
        <a href={withBase('trips/gangtok/')} style="--i:2">12,310 ft up at Tsomgo Lake <span>— Sikkim</span></a>
        <a class="reserve-line" href="#reserve" style="--i:3">Reserve a whole bus <span>— AC, Non-AC, Sleeper</span></a>
      </div>
      <div class="board">
        <div class="flapwrap"><span class="eyebrow">Where we go</span><div class="flaps" id="flaps" data-words={[...trips.map((t) => t.data.name), ...extras.map((d) => d.name)].map((name) => name.toUpperCase()).join(',')} aria-hidden="true"></div></div>
      </div>
    </div>
  </section>

  <section class="tours" id="lines" aria-labelledby="net-h">
    <header class="network">
      <div class="wrap">
        <span class="eyebrow">The network · every line leaves Rourkela</span>
        <h2 id="net-h" tabindex="-1">Pick a line. <span class="soft">We handle the ride.</span></h2>
      </div>
    </header>
    <div class="wrap cards">
      {trips.map(({ id, data: t }) => (
        <article class="card" id={id} style={`--c:${t.color};--on:${t.onColor}`}>
          <div class="card-media">
            <Photo src={t.hero} alt={t.heroAlt} sizes={sizes} />
            <span class="code">LINE {t.code}</span>
          </div>
          <div class="card-body">
            <span class="eyebrow">{t.name} · {t.region}</span>
            {/* The title link covers the whole card, so a tap anywhere opens the trip. */}
            <h3><a class="card-link" href={withBase(`trips/${id}/`)}>{t.title}</a></h3>
            <p>{t.dek}</p>
            <div class="card-actions">
              <a class="btn-wa" href={whatsappLink(tourMessage(t.name))} target="_blank" rel="noopener"><WhatsAppIcon /> Ask for dates</a>
              <span class="card-more" aria-hidden="true">See the trip →</span>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="wrap">
      <h3 class="eyebrow plan-h">Plan with us · tell us your dates and we build the trip</h3>
    </div>
    <div class="wrap cards">
      {extras.map((d) => (
        <article class="card">
          <div class="card-media"><Photo src={photo(d.photo)} alt={d.photoAlt} sizes={sizes} /></div>
          <div class="card-body">
            <span class="eyebrow">{d.name} · {d.region}</span>
            <h3>{d.title}</h3>
            <p>{d.dek}</p>
            <div class="card-actions">
              <a class="btn-wa" href={whatsappLink(tourMessage(d.name))} target="_blank" rel="noopener"><WhatsAppIcon /> Plan it with us</a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div class="incl">
      <div class="wrap">
        <h3 class="eyebrow">In every ticket</h3>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="13" rx="3"/><path d="M4 11h16M8 21l1.5-4M16 21l-1.5-4"/></svg>Train, bus or flight booked for you</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20V8l9-5 9 5v12"/><path d="M9 20v-6h6v6"/></svg>Hotels and houseboats we have checked</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/></svg>Sightseeing and permits sorted</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/></svg>A real person on call, 24x7</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="quote">
    <div class="wrap">
      <blockquote>“Our Manali trip from Rourkela was <span class="hl">perfectly managed.</span> Hotels, food and sightseeing were excellent.”</blockquote>
      <cite>Rahul Sharma · Line M6, Manali</cite>
    </div>
  </section>

  <ReserveBus />
  <BookingEngine />
</Base>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Split-flap board of the tours.
  const flaps = document.getElementById('flaps');
  if (flaps) {
    const words = (flaps.dataset.words ?? '').split(',');
    const width = Math.max(...words.map((w) => w.length));
    const cells = Array.from({ length: width }, () => flaps.appendChild(Object.assign(document.createElement('span'), { className: 'flap' })));
    const show = (word: string) => {
      const padded = word.padEnd(width, ' ');
      cells.forEach((cell, i) => {
        if (reduceMotion) { cell.textContent = padded[i]; return; }
        setTimeout(() => {
          cell.classList.add('flip');
          setTimeout(() => { cell.textContent = padded[i]; cell.classList.remove('flip'); }, 140);
        }, i * 70);
      });
    };
    let index = 0;
    show(words[0]);
    if (!reduceMotion) setInterval(() => show(words[++index % words.length]), 3200);
  }
</script>
