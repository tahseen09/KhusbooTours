---
import { getCollection } from 'astro:content';
import Photo from '../components/Photo.astro';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import RouteLine from '../components/RouteLine.astro';
import { PHONE_DISPLAY, formatPrice, whatsappLink, withBase } from '../lib/site';
import coverPhoto from '../assets/photos/cover-dal-lake-houseboats.jpg';

const trips = (await getCollection('trips')).sort((a, b) => a.data.order - b.data.order);
const ogImage = await getImage({ src: coverPhoto, width: 1200, format: 'jpg', quality: 70 });
const cheapest = Math.min(...trips.map((t) => t.data.price));
const nights = (n: string) => n.replace('/', ' / ');

// Every tour and every stop on it is a searchable destination.
const places = trips.flatMap(({ id, data: t }, index) => {
  const names = [...new Set([t.name, ...t.stops, ...t.days.map((d) => d.place)])].filter((n) => n !== 'Home');
  return names.map((place) => ({
    place, index, href: withBase(`trips/${id}/`),
    detail: place === t.name ? `${nights(t.nights)} · from ${formatPrice(t.price)}` : `On the ${t.name} tour`,
    haystack: [place, t.name, t.city, t.bestFor, t.summary, ...t.tags, ...t.stops].join(' ').toLowerCase(),
  }));
});
---
<Base
  title="Khusboo Tours · Tours from Rourkela to Kashmir, Gangtok, Manali and Goa"
  description={`Tour packages from Rourkela, Odisha. Kashmir, Gangtok, Manali and Goa with travel, hotels and sightseeing planned for you. From ${formatPrice(cheapest)} per person.`}
  ogImage={ogImage.src}
>
  <section class="cover" aria-label="Cover">
    <div class="cover-img">
      <Photo src={coverPhoto} alt="Houseboats on Dal Lake below snow-capped mountains" sizes="100vw" priority />
    </div>
    <div class="masthead"><span class="mh-name">KHUSBOO</span><span class="mh-sub">Tours</span></div>
    <div class="issue-line"><span>Issue 01</span><span>Winter 2026</span></div>
    <div class="cover-body">
      <h1>Fill your <em>soul.</em></h1>
      <ul class="cover-tours" aria-label="Tours in this issue">
        {trips.map(({ id, data: t }, i) => (
          <li><a href={withBase(`trips/${id}/`)} data-go={i}><b>{t.name}</b><span>{nights(t.nights)} · from {formatPrice(t.price)}</span></a></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="contents" id="contents" aria-labelledby="contents-h">
    <div class="wrap">
      <div class="contents-head">
        <span class="label">In this issue</span>
        <h2 id="contents-h">Four tours from Rourkela</h2>
        <p>Travel, hotels and sightseeing planned for you. Pick one, or tell us where you want to go.</p>
        <form class="search" id="search" role="search">
          <label class="sr" for="q">Search destinations</label>
          <input id="q" type="search" placeholder="Search Gulmarg, beach, snow…" autocomplete="off" aria-controls="results" />
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
          <ul class="results" id="results" hidden>
            {places.map((p) => <li data-search={p.haystack}><a href={p.href} data-go={p.index}><b>{p.place}</b><span>{p.detail}</span></a></li>)}
            <li class="none" id="no-results" hidden>No tour goes there yet. Message us and we will plan it.</li>
          </ul>
          <p class="sr" id="status" aria-live="polite"></p>
        </form>
      </div>
      <ol class="toc">
        {trips.map(({ id, data: t }, i) => (
          <li><a href={withBase(`trips/${id}/`)} data-go={i}><span class="pg">{t.page}</span><b>{t.name}</b><span class="price">from {formatPrice(t.price)}</span><span class="sub">{nights(t.nights)} · {t.summary}</span></a></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="issue" id="issue" aria-labelledby="issue-h">
    <div class="wrap issue-bar">
      <h2 id="issue-h">The features</h2>
      <div class="controls">
        <button class="arrow" type="button" id="prev" aria-label="Previous tour"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg></button>
        <span class="count" id="count">1 / {trips.length}</span>
        <button class="arrow" type="button" id="next" aria-label="Next tour"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
    </div>
    <div class="spreads" id="spreads" tabindex="0" aria-label="Tour features. Swipe or use the arrows.">
      {trips.map(({ id, data: t }) => (
        <article class="spread" id={id} style={`--c:${t.color}`} aria-label={`${t.name} tour`}>
          <figure class="spread-photo">
            <Photo src={t.hero} alt={t.heroAlt} sizes="(min-width: 1000px) 560px, 86vw" />
            <figcaption>{t.place}</figcaption>
          </figure>
          <div class="spread-text">
            <span class="label">The {t.name} tour</span>
            <h3><a href={withBase(`trips/${id}/`)}>{t.title}</a></h3>
            <p class="dek">{t.dek}</p>
            <RouteLine stops={t.stops} />
            <dl class="facts">
              <div><dt>Duration</dt><dd>{nights(t.nights)}</dd></div>
              <div><dt>From</dt><dd>{formatPrice(t.price)}</dd></div>
              <div><dt>Best time</dt><dd>{t.best}</dd></div>
              <div><dt>Highest point</dt><dd>{t.highest}</dd></div>
            </dl>
            <div class="cta-row">
              <a class="btn" href={whatsappLink(`Hi Khusboo Tours, I want to book the ${t.name} tour (${t.nights}).`)} target="_blank" rel="noopener"><WhatsAppIcon /> Book on WhatsApp</a>
              <a class="btn ghost" href={withBase(`trips/${id}/`)}>Read the itinerary</a>
            </div>
          </div>
          <div class="folio"><span>Khusboo Tours · Issue 01</span><span>p. {t.page}</span></div>
        </article>
      ))}
    </div>
    <p class="hint"><span>Swipe for the next tour</span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></p>
  </section>

  <section class="quote wrap">
    <blockquote>“Our Manali trip from Rourkela was perfectly managed. Hotels, food and sightseeing were excellent.”</blockquote>
    <cite class="label">Rahul Sharma · Manali</cite>
  </section>

  <section class="contact" id="contact">
    <div class="wrap">
      <span class="label">Plan a trip</span>
      <h2>Let’s plan yours.</h2>
      <p>Tell us where, when and who is coming. We reply on WhatsApp with a plan and a price.</p>
      <a class="btn" href={whatsappLink()} target="_blank" rel="noopener"><WhatsAppIcon /> Message us on WhatsApp</a>
      <p class="phone">or call <a href="tel:+919438836765">{PHONE_DISPLAY}</a></p>
    </div>
  </section>
</Base>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Spreads: arrows, counter and keyboard. Native scroll-snap does the swiping.
  const track = document.getElementById('spreads')!;
  const spreads = Array.from(track.children) as HTMLElement[];
  const prev = document.getElementById('prev') as HTMLButtonElement;
  const next = document.getElementById('next') as HTMLButtonElement;
  const count = document.getElementById('count')!;
  let current = 0;
  const offsetOf = (el: HTMLElement) => el.offsetLeft - track.offsetLeft - parseFloat(getComputedStyle(track).scrollPaddingLeft || '0');
  const goTo = (i: number) => {
    current = Math.max(0, Math.min(spreads.length - 1, i));
    track.scrollTo({ left: offsetOf(spreads[current]), behavior: reduceMotion ? 'auto' : 'smooth' });
  };
  const sync = () => {
    let best = 0, distance = Infinity;
    spreads.forEach((s, i) => { const d = Math.abs(offsetOf(s) - track.scrollLeft); if (d < distance) { distance = d; best = i; } });
    current = best;
    count.textContent = `${current + 1} / ${spreads.length}`;
    prev.disabled = current === 0;
    next.disabled = current === spreads.length - 1;
  };
  prev.addEventListener('click', () => goTo(current - 1));
  next.addEventListener('click', () => goTo(current + 1));
  track.addEventListener('scroll', () => requestAnimationFrame(sync), { passive: true });
  track.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
    if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current - 1); }
  });
  sync();

  // On this page, tour links open the tour's spread. Modified clicks still open the tour page.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('[data-go]');
    if (!link || e.metaKey || e.ctrlKey || e.shiftKey) return;
    e.preventDefault();
    document.getElementById('issue')!.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
    setTimeout(() => goTo(Number(link.dataset.go)), reduceMotion ? 0 : 450);
  });

  // Destination search: lists every destination on focus and narrows as you type.
  const form = document.getElementById('search') as HTMLFormElement;
  const input = document.getElementById('q') as HTMLInputElement;
  const results = document.getElementById('results')!;
  const none = document.getElementById('no-results')!;
  const status = document.getElementById('status')!;
  const items = Array.from(results.querySelectorAll<HTMLLIElement>('li[data-search]'));
  const render = () => {
    const terms = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let shown = 0;
    items.forEach((li) => { li.hidden = !terms.every((t) => (li.dataset.search ?? '').includes(t)); if (!li.hidden) shown++; });
    none.hidden = shown > 0;
    results.hidden = false;
    status.textContent = `${shown} destinations found`;
  };
  const close = () => { results.hidden = true; };
  input.addEventListener('focus', render);
  input.addEventListener('input', render);
  input.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') close();
    if (e.key === 'ArrowDown') { e.preventDefault(); items.find((li) => !li.hidden)?.querySelector('a')?.focus(); }
  });
  results.addEventListener('keydown', (e) => {
    if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
    e.preventDefault();
    const links = items.filter((li) => !li.hidden).map((li) => li.querySelector('a')!);
    const i = links.indexOf(document.activeElement as HTMLAnchorElement);
    (links[e.key === 'ArrowDown' ? i + 1 : i - 1] ?? input).focus();
  });
  form.addEventListener('submit', (e) => { e.preventDefault(); items.find((li) => !li.hidden)?.querySelector('a')?.click(); });
  document.addEventListener('click', (e) => { const t = e.target as Element; if (!form.contains(t) || t.closest('.results a')) close(); });

  // The header search icon focuses the search box.
  document.querySelector('[data-search-link]')?.addEventListener('click', (e) => {
    e.preventDefault();
    document.getElementById('contents')!.scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth' });
    setTimeout(() => input.focus({ preventScroll: true }), reduceMotion ? 0 : 500);
  });
</script>
