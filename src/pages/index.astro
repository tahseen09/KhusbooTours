---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Photo from '../components/Photo.astro';
import Base from '../layouts/Base.astro';
import BoardingPass from '../components/BoardingPass.astro';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { PHONE_DISPLAY, whatsappLink, withBase } from '../lib/site';
import coverPhoto from '../assets/photos/cover-dal-lake-houseboats.jpg';
import backPhoto from '../assets/photos/sikkim-kanchenjunga.jpg';

const trips = (await getCollection('trips')).sort((a, b) => a.data.order - b.data.order);
const sizes = '(min-width: 900px) 55vw, 100vw';
const og = await getImage({ src: coverPhoto, width: 1200, format: 'jpg', quality: 70 });
// Every trip and every stop on it becomes a searchable destination.
const places = trips.flatMap(({ id, data: t }) => {
  const names = [t.name, ...t.stops, ...t.days.map((d) => d.place)].filter((n) => n !== 'Home');
  return [...new Set(names)].map((place) => ({
    tripId: id, tripName: t.name, place, code: t.code, color: t.color, onColor: t.onColor, nights: t.nights,
    haystack: [place, t.name, t.city, t.bestFor, ...t.tags, ...t.stops].join(' ').toLowerCase(),
  }));
});
const filters = [
  { key: 'all', label: `All ${trips.length} trips` },
  { key: 'snow', label: 'Snow' },
  { key: 'beach', label: 'Beach' },
  { key: 'adventure', label: 'Adventure' },
];
---
<Base
  title="Khusboo Tours · Trips from Rourkela to Kashmir, Gangtok, Manali and Goa"
  description={`Tour packages from Rourkela, Odisha. Kashmir, Gangtok, Manali and Goa with travel, hotels and sightseeing included.`}
  ogImage={og.src}
>
  <section class="cover" aria-label="Cover">
    <div class="cover-img">
      <Photo src={coverPhoto} alt="Houseboats moored below snow-capped mountains" sizes="100vw" priority />
    </div>
    <h1 aria-label="Escape">
      <span class="row" aria-hidden="true"><span class="ch" style="--i:0">E</span><span class="ch" style="--i:1">S</span><span class="ch" style="--i:2">C</span></span>
      <span class="row" aria-hidden="true"><span class="ch" style="--i:3">A</span><span class="ch" style="--i:4">P</span><span class="ch" style="--i:5">E</span></span>
    </h1>
    <p class="dek">The issue for people who need a weekend that lasts a week.</p>
    <div class="cover-foot">
      <div class="cover-lines">
        <a href={withBase('trips/kashmir/')} style="--i:0">Snow before breakfast <span>— Gulmarg</span></a>
        <a href={withBase('trips/goa/')} style="--i:1">Goa at golden hour <span>— Mandrem</span></a>
        <a href={withBase('trips/gangtok/')} style="--i:2">12,310 ft up at Tsomgo Lake <span>— Sikkim</span></a>
      </div>
      <div class="board">
        <div class="flapwrap"><span class="eyebrow">Where we go</span><div class="flaps" id="flaps" data-words={trips.map((t) => t.data.name.toUpperCase()).join(',')} aria-hidden="true"></div></div>
      </div>
    </div>
  </section>

  <section class="network" id="lines" aria-labelledby="net-h">
    <div class="wrap">
      <span class="eyebrow">The network · every line leaves Rourkela</span>
      <h2 id="net-h">Pick a line. <span class="soft">We handle the ride.</span></h2>
      <form class="search" id="search" role="search" action={withBase('')}>
        <label class="visually-hidden" for="search-input">Search destinations</label>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
        <input id="search-input" type="search" placeholder="Where to? Try Gulmarg, beach, snow" autocomplete="off" aria-controls="search-results" aria-describedby="search-status" />
        <ul class="search-results" id="search-results" hidden>
          {places.map((p) => (
            <li data-search={p.haystack}>
              <a href={withBase(`trips/${p.tripId}/`)} style={`--c:${p.color};--on:${p.onColor}`}>
                <span class="code">{p.code}</span>
                <span><b>{p.place}</b><span class="soft">{p.place === p.tripName ? p.nights : `On the ${p.tripName} trip · ${p.nights}`}</span></span>
              </a>
            </li>
          ))}
          <li class="search-empty" id="search-empty" hidden>No trip goes there yet. Ask us on WhatsApp and we will plan it.</li>
        </ul>
        <p class="visually-hidden" id="search-status" aria-live="polite"></p>
      </form>
      <div class="chips" role="group" aria-label="Filter trips">
        {filters.map((f, i) => <button class="chip" type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>{f.label}</button>)}
      </div>
      <div class="hub"><span class="hub-dot"></span><b>Rourkela</b><span class="mono">HUB · ROU</span></div>
      {trips.map(({ id, data: t }) => (
        <a class="route" href={withBase(`trips/${id}/`)} data-tags={t.tags.join(' ')} style={`--c:${t.color};--on:${t.onColor};--d:${t.busSeconds}s`}>
          <span class="trunk"></span>
          <span class="route-body">
            <span class="route-head"><span class="code">{t.code}</span><b>{t.name}</b><span class="mono">{t.nights}</span></span>
            <span class="track">
              <span class="bus"><svg viewBox="0 0 30 20" aria-hidden="true"><rect x="1" y="1" width="28" height="14" rx="3" fill="currentColor"/><rect x="4" y="4" width="5" height="5" rx="1" fill="#F1F3F0"/><rect x="11" y="4" width="5" height="5" rx="1" fill="#F1F3F0"/><rect x="18" y="4" width="5" height="5" rx="1" fill="#F1F3F0"/><circle cx="8" cy="16" r="3" fill="currentColor" stroke="#F1F3F0" stroke-width="1.5"/><circle cx="22" cy="16" r="3" fill="currentColor" stroke="#F1F3F0" stroke-width="1.5"/></svg></span>
              <span class="stops">{t.stops.map((s) => <span class="stop">{s}</span>)}</span>
            </span>
          </span>
        </a>
      ))}
    </div>
  </section>

  {trips.map(({ id, data: t }) => (
    <article class="feature" id={id} data-tags={t.tags.join(' ')} style={`--bg:${t.background};--fg:${t.foreground};--c:${t.color};--on:${t.onColor}`}>
      <div class="f-grid">
        <div class="f-media">
          <Photo src={t.hero} alt={t.heroAlt} sizes={sizes} />
          <span class="code">LINE {t.code}</span>
          <span class="place">{t.place}</span>
        </div>
        <div class="f-copy">
          <span class="eyebrow">{t.kicker}</span>
          <h3><a href={withBase(`trips/${id}/`)}>{t.title}</a></h3>
          <p class="dek-text">{t.dek}</p>
          <BoardingPass trip={t} />
          <a class="read" href={withBase(`trips/${id}/`)}>Read the full itinerary →</a>
        </div>
      </div>
    </article>
  ))}

  <section class="quote">
    <div class="wrap">
      <blockquote>“Our Manali trip from Rourkela was <span class="hl">perfectly managed.</span> Hotels, food and sightseeing were excellent.”</blockquote>
      <cite>Rahul Sharma · Line M6, Manali</cite>
    </div>
  </section>

  <section class="incl" aria-labelledby="incl-h">
    <div class="wrap">
      <span class="eyebrow">In every ticket</span>
      <h2 id="incl-h">You pack the bag. <span class="soft">We do the rest.</span></h2>
      <ul>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="4" width="16" height="13" rx="3"/><path d="M4 11h16M8 21l1.5-4M16 21l-1.5-4"/></svg>Train, bus or flight booked for you</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 20V8l9-5 9 5v12"/><path d="M9 20v-6h6v6"/></svg>Hotels and houseboats we have checked</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4L3 6v14l6-2 6 2 6-2V4l-6 2z"/><path d="M9 4v14M15 6v14"/></svg>Sightseeing and permits sorted</li>
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1z"/></svg>A real person on call, 24x7</li>
      </ul>
    </div>
  </section>

  <section class="back" aria-labelledby="back-h">
    <div class="back-img"><Photo src={backPhoto} alt="Kanchenjunga glowing gold at sunrise" sizes="100vw" /></div>
    <div class="wrap">
      <span class="eyebrow">Back cover</span>
      <h2 id="back-h">Your seat is waiting.</h2>
      <a class="btn-wa" href={whatsappLink()} target="_blank" rel="noopener"><WhatsAppIcon /> Say hi on WhatsApp</a>
      <span class="phone">or call <a href="tel:+919438836765">{PHONE_DISPLAY}</a></span>
    </div>
  </section>
</Base>

<script>
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Trip filters: dim routes and hide feature spreads that do not match.
  const chips = document.querySelectorAll<HTMLButtonElement>('.chip');
  chips.forEach((chip) => chip.addEventListener('click', () => {
    const filter = chip.dataset.filter ?? 'all';
    chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
    const matches = (el: HTMLElement) => filter === 'all' || (el.dataset.tags ?? '').split(' ').includes(filter);
    document.querySelectorAll<HTMLElement>('.route').forEach((r) => r.classList.toggle('dim', !matches(r)));
    document.querySelectorAll<HTMLElement>('.feature').forEach((f) => { f.hidden = !matches(f); });
  }));

  // Destination search: shows every destination on focus, narrows as you type.
  const searchForm = document.getElementById('search') as HTMLFormElement | null;
  const searchInput = document.getElementById('search-input') as HTMLInputElement | null;
  const results = document.getElementById('search-results');
  const status = document.getElementById('search-status');
  if (searchForm && searchInput && results && status) {
    const items = Array.from(results.querySelectorAll<HTMLLIElement>('li[data-search]'));
    const empty = document.getElementById('search-empty');
    const update = () => {
      const terms = searchInput.value.toLowerCase().split(/\s+/).filter(Boolean);
      let shown = 0;
      items.forEach((li) => {
        const match = terms.every((term) => (li.dataset.search ?? '').includes(term));
        li.hidden = !match;
        if (match) shown++;
      });
      results.hidden = false;
      if (empty) empty.hidden = shown > 0;
      status.textContent = shown ? `${shown} destination${shown === 1 ? '' : 's'} found` : 'No destinations found';
    };
    searchInput.addEventListener('focus', update);
    searchInput.addEventListener('input', update);
    searchForm.addEventListener('submit', (event) => {
      event.preventDefault();
      const first = items.find((li) => !li.hidden)?.querySelector('a');
      if (first) location.href = first.href;
    });
    document.addEventListener('click', (event) => {
      if (!searchForm.contains(event.target as Node)) { results.hidden = true; status.textContent = ''; }
    });
    searchInput.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') { results.hidden = true; status.textContent = ''; }
      if (event.key === 'ArrowDown') { event.preventDefault(); items.find((li) => !li.hidden)?.querySelector('a')?.focus(); }
    });
    results.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowDown' && event.key !== 'ArrowUp') return;
      event.preventDefault();
      const links = items.filter((li) => !li.hidden).map((li) => li.querySelector('a')!);
      const i = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next = event.key === 'ArrowDown' ? links[i + 1] : links[i - 1];
      (next ?? searchInput).focus();
    });
  }

  // Split-flap board of the tours.
  const flaps = document.getElementById('flaps');
  if (flaps) {
    const words = (flaps.dataset.words ?? '').split(',');
    const width = Math.max(...words.map((w) => w.length));
    const cells = Array.from({ length: width }, () => flaps.appendChild(Object.assign(document.createElement('span'), { className: 'flap' })));
    const show = (word: string) => {
      const padded = word.padEnd(width, ' ');
      cells.forEach((cell, i) => {
        if (reduceMotion) { cell.textContent = padded[i]; return; }
        setTimeout(() => {
          cell.classList.add('flip');
          setTimeout(() => { cell.textContent = padded[i]; cell.classList.remove('flip'); }, 140);
        }, i * 70);
      });
    };
    let index = 0;
    show(words[0]);
    if (!reduceMotion) setInterval(() => show(words[++index % words.length]), 3200);
  }
</script>
