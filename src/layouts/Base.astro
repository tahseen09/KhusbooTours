---
import '@fontsource/cormorant-garamond/latin-300.css';
import '@fontsource/cormorant-garamond/latin-300-italic.css';
import '@fontsource/cormorant-garamond/latin-400.css';
import '@fontsource/cormorant-garamond/latin-400-italic.css';
import '@fontsource/cormorant-garamond/latin-500.css';
import '@fontsource-variable/inter';
import '../styles/global.css';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { PHONE_DISPLAY, whatsappLink, withBase } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  /** Pages without a photo hero need dark header text. */
  onPaper?: boolean;
  showFab?: boolean;
}
const { title, description, ogImage, onPaper = false, showFab = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navTrips = [
  { slug: 'kashmir', label: 'Kashmir' },
  { slug: 'gangtok', label: 'Gangtok' },
  { slug: 'manali', label: 'Manali' },
  { slug: 'goa', label: 'Goa' },
];
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#FAF9F6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class:list={['mast', { 'on-paper': onPaper }]}>
      <a class="mini-logo" href={withBase('')} aria-label="Khusboo Tours home">K</a>
      <nav aria-label="Main">
        {navTrips.map((t, i) => <a class="tour-link" href={withBase(`trips/${t.slug}/`)} data-go={i}>{t.label}</a>)}
        <a class="tours-btn" href={withBase('#contents')}>All tours</a>
        <a class="icon-btn" href={withBase('#contents')} data-search-link aria-label="Search destinations"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></a>
      </nav>
    </header>

    <main><slot /></main>

    <footer class="site-foot">
      <div class="wrap">
        <strong>KHUSBOO TOURS</strong>
        <span>Anand Bhawan Lane, Main Road, Rourkela, Odisha 769001</span>
        <span>support@khusbootours.in · {PHONE_DISPLAY} · GSTIN 21AFZPA6890C1ZE</span>
        <nav aria-label="Tours">{navTrips.map((t) => <a href={withBase(`trips/${t.slug}/`)}>{t.label}</a>)}</nav>
      </div>
    </footer>

    {showFab && <a class="fab" id="fab" href={whatsappLink()} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp"><WhatsAppIcon /></a>}

    <script>
      const fab = document.getElementById('fab');
      const hero = document.querySelector('.cover, .trip-hero');
      if (fab && hero) new IntersectionObserver(([entry]) => fab.classList.toggle('show', !entry.isIntersecting)).observe(hero);
      else fab?.classList.add('show');
    </script>
  </body>
</html>
