---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/jetbrains-mono';
import '@fontsource/instrument-serif/400.css';
import '@fontsource/instrument-serif/400-italic.css';
import '../styles/global.css';
import WhatsAppIcon from '../components/WhatsAppIcon.astro';
import { PHONE_DISPLAY, whatsappLink, withBase } from '../lib/site';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  backLink?: boolean;
  whatsappMessage?: string;
}
const { title, description, ogImage, backLink = false, whatsappMessage } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const navTrips = [
  { href: 'trips/kashmir/', label: 'Kashmir' },
  { href: 'trips/gangtok/', label: 'Gangtok' },
  { href: 'trips/manali/', label: 'Manali' },
  { href: 'trips/goa/', label: 'Goa' },
];
---
<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={withBase('favicon.svg')} type="image/svg+xml" />
    <meta name="theme-color" content="#0B0D12" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImage && <meta property="og:image" content={new URL(ogImage, Astro.site)} />}
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="mast">
      {backLink
        ? <a class="back-link" href={withBase('#lines')}>← All trips</a>
        : <a class="mast-logo" href={withBase('')}><b>KHUSBOO</b><span class="eyebrow">Issue 01</span></a>}
      <div class="mast-right">
        <nav aria-label="Trips">
          {navTrips.map((t) => <a href={withBase(t.href)}>{t.label}</a>)}
          <a href={withBase('#reserve')}>Reserve a bus</a>
        </nav>
        <a class="mast-search" href={withBase('#search')} aria-label="Search destinations" data-search-link><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg></a>
        {!backLink && <a class="mast-book" href={withBase('#book')}>Book</a>}
        {backLink && <a class="mast-logo" href={withBase('')}><b>KHUSBOO</b></a>}
      </div>
    </header>

    <main><slot /></main>

    <footer class="site-foot">
      <div class="wrap">
        <strong>KHUSBOO</strong>
        <span>Anand Bhawan Lane, Main Road, Rourkela, Odisha 769001</span>
        <span>support@khusbootours.in · {PHONE_DISPLAY}</span>
        <nav aria-label="Footer">
          {navTrips.map((t) => <a href={withBase(t.href)}>{t.label}</a>)}
          <a href={withBase('#book')}>Book a tour</a>
          <a href={withBase('#reserve')}>Reserve a bus</a>
        </nav>
        <span class="mono" style="font-size:11px">GSTIN 21AFZPA6890C1ZE</span>
      </div>
    </footer>

    <a class="fab" id="fab" href={whatsappLink(whatsappMessage)} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp"><WhatsAppIcon /></a>

    <script>
      // On the home page the search icon jumps to the search box and focuses it.
      const searchInput = document.getElementById('search-input');
      document.querySelector('[data-search-link]')?.addEventListener('click', (event) => {
        if (!searchInput) return;
        event.preventDefault();
        document.getElementById('search')?.scrollIntoView();
        setTimeout(() => searchInput.focus({ preventScroll: true }), 400);
      });
      // Two WhatsApp buttons on screen at once is one too many, and the floating one covers the other.
      const fab = document.getElementById('fab')!;
      const visible = new Set<Element>();
      const waButtons = new IntersectionObserver((entries) => {
        entries.forEach((entry) => entry.isIntersecting ? visible.add(entry.target) : visible.delete(entry.target));
        fab.classList.toggle('near-wa', visible.size > 0);
      });
      document.querySelectorAll('main .btn-wa, main .fleet a').forEach((button) => waButtons.observe(button));
      if (searchInput && location.hash === '#search') {
        // The jump to the #search anchor clears focus, so focus after the page has loaded.
        addEventListener('load', () => setTimeout(() => searchInput.focus({ preventScroll: true })));
      }
    </script>
  </body>
</html>
